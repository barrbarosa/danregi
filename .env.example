# כתובת ה-endpoint החיצוני שאליו מועברת הפנייה.
# TODO: להחליף לכתובת האמיתית כשיתקבל חוזה הממשק מבעל השירות.
# בפיתוח אפשר להצביע על יעד הבדיקה המקומי:
#   http://localhost:3000/api/mock?scenario=ok
#   scenario אפשריים: ok | slow | error | reject
INQUIRY_ENDPOINT_URL=

# טוקן אימות מול היעד. נשלח ככותרת Authorization: Bearer.
# אופציונלי. לעולם לא נחשף לדפדפן.
INQUIRY_ENDPOINT_TOKEN=
